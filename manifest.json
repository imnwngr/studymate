{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.8.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "studymate"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://learn.eltngl.com/*",
    "https://*.avallain.net/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.eltngl.com/*",
        "https://*.avallain.net/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "qti.js",
        "core/site-registry.js",
        "solvers/interactions.js",
        "solvers/sequence.js",
        "solvers/text-correction.js",
        "answer-sources/embedded-qti.js",
        "core/runtime.js",
        "adapters/ngl.js",
        "adapters/generic.js",
        "content.js",
        "inspector-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
